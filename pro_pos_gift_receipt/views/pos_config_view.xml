<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_config_form_gift_receipt_qty_only" model="ir.ui.view">
        <field name="name">pos.config.form.gift.receipt.qty.only</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Gift Receipt">
                    <field name="enable_gift_receipt_qty_only"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
